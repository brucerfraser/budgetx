#!/bin/sh
# Refuses pushes whose refs violate the repo budget (belt to the pre-commit check).
ret=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  python3 "$(git rev-parse --show-toplevel)/tools/repo_guard.py" --tree "$local_sha" || ret=1
done
exit $ret
