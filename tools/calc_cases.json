    { "name": "smart_index_lowercases_every_indexed_word", "fn": "bxSmartIndex", "args": [{ "$ref": "caseTxns" }], "expect": { "version": 1, "categories": { "sub-cafe": { "words": { "vida": true, "caffe": true, "rosebank": true }, "last_date": "2024-05-01", "txn_count": 1 } } } },
    { "name": "smart_index_keeps_the_latest_date_across_two_rows_of_one_category", "fn": "bxSmartIndex", "args": [{ "$ref": "dateTieTxns" }], "expect": { "version": 1, "categories": { "sub-aaa": { "words": { "spar": true, "market": true }, "last_date": "2024-01-05", "txn_count": 1 }, "sub-bbb": { "words": { "spar": true, "central": true }, "last_date": "2024-06-20", "txn_count": 1 } } } },

    {
      "name": "suggest_beats_the_legacy_tie_bug_by_scoring_match_COUNT",
      "fn": "bxSuggest",
      "args": [{ "$index": "tieTxns" }, "WOOLWORTHS FOOD MIDRAND"],
      "expect": { "sub_category_id": "sub-bbb-groceries", "score": 3 },
      "legacy_compare": {
        "fixture": "tieTxns",
        "description": "WOOLWORTHS FOOD MIDRAND",
        "legacy_expect": "sub-aaa-fuel",
        "_why": "Legacy scores every matching category as exactly 1 and max() returns the first inserted, so it answers sub-aaa-fuel on the strength of the single word MIDRAND. bxSuggest matches WOOLWORTHS, FOOD and MIDRAND against sub-bbb-groceries for a score of 3. Note that sub-aaa-fuel also sorts FIRST by id, so the id tiebreak would give the legacy answer too — only the count-based score reaches the right one."
      }
    },
    {
      "name": "suggest_is_case_insensitive_where_the_legacy_finds_nothing",
      "fn": "bxSuggest",
      "args": [{ "$index": "caseTxns" }, "VIDA E CAFFE"],
      "expect": { "sub_category_id": "sub-cafe", "score": 2 },
      "legacy_compare": {
        "fixture": "caseTxns",
        "description": "VIDA E CAFFE",
        "legacy_expect": null,
        "_why": "The index was built from 'Vida e Caffe Rosebank'. The legacy match is case-sensitive so it returns None; bxSuggest lowercases both sides and scores 2 (vida, caffe — the one-letter 'e' is below the length-3 floor)."
      }
    },
    { "name": "suggest_returns_null_when_nothing_matches", "fn": "bxSuggest", "args": [{ "$index": "mixed" }, "AIRPORT PARKING FEE"], "expect": null },
    { "name": "suggest_returns_null_when_every_word_is_shorter_than_three_characters", "fn": "bxSuggest", "args": [{ "$index": "mixed" }, "a b cd"], "expect": null },
    { "name": "suggest_returns_null_against_an_empty_index", "fn": "bxSuggest", "args": [{ "$index": "empty" }, "WOOLWORTHS SANDTON"], "expect": null },
    { "name": "suggest_tiebreak_on_equal_score_prefers_the_most_recent_transaction", "fn": "bxSuggest", "args": [{ "$index": "dateTieTxns" }, "SPAR"], "expect": { "sub_category_id": "sub-bbb", "score": 1 } },
    { "name": "suggest_tiebreak_on_equal_score_and_equal_date_prefers_sub_category_id_ascending", "fn": "bxSuggest", "args": [{ "$index": "idTieTxns" }, "KWIKSPAR"], "expect": { "sub_category_id": "sub-mmm", "score": 1 } },
    { "name": "suggest_counts_a_repeated_word_once_so_it_cannot_inflate_a_score", "fn": "bxSuggest", "args": [{ "$index": "dateTieTxns" }, "SPAR SPAR SPAR"], "expect": { "sub_category_id": "sub-bbb", "score": 1 } },
    { "name": "suggest_leads_with_a_strong_score_when_two_words_match", "fn": "bxSuggest", "args": [{ "$index": "mixed" }, "WOOLWORTHS SANDTON CITY"], "expect": { "sub_category_id": "sub-groceries", "score": 2 } }
  ]
