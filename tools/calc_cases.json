    { "name": "group_by_sub_after_excluding_transfers_has_no_sentinel_bucket", "fn": "bxGroupBySub", "args": [{ "$call": { "fn": "bxExcludeTransfers", "args": [{ "$ref": "transferRows" }, "ec8e0085-8408-43a2-953f-ebba24549d96"] } }], "expect": { "sub-groceries": -9900, "sub-salary": 120000 } },

